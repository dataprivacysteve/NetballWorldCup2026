# ======================================================================
# GameDay · Local Chassis Environment
# ----------------------------------------------------------------------
# Copy this file to `.env` (which is gitignored and never leaves your
# machine) and adjust if you wish. Chad sets these SAME KEYS on the
# server with production values.
#
# This file is the laptop -> server seam. Nothing in the codebase is
# hardcoded; the same build runs in both places with only these values
# changing. The KEYS are the contract; the VALUES differ by environment.
# ======================================================================

# ---- PostgreSQL ------------------------------------------------------
# The superuser is for administration and running migrations only.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local_dev_only_change_me
POSTGRES_DB=gameday

# The runtime role the NestJS API connects as. It is NOSUPERUSER and
# RLS-bound — tenant isolation depends on the app using THIS role.
# This value must match the password embedded in DATABASE_URL below.
GAMEDAY_APP_PASSWORD=local_dev_only_app_pw

# The connection string the API reads. Note the user is gameday_app,
# NOT postgres.
#   Laptop: host is localhost.
#   Server: Chad points this at the managed Postgres host, same shape.
DATABASE_URL=postgresql://gameday_app:local_dev_only_app_pw@localhost:5432/gameday

# The read-only role the PUBLIC (www) surface connects as. SELECT-only, no DML,
# and granted only the public match tables + public-safe views — never the
# tenant base tables. This is the unauthenticated read path (Module 4).
# Must match the password embedded in PUBLIC_DATABASE_URL below.
GAMEDAY_PUBLIC_PASSWORD=local_dev_only_public_pw

# The connection string the API's public read layer uses. User is
# gameday_public, NOT gameday_app or postgres.
PUBLIC_DATABASE_URL=postgresql://gameday_public:local_dev_only_public_pw@localhost:5432/gameday

# Admin connection used ONLY for migrations and the dev seed — never at runtime.
# Connects as the superuser so DDL/RLS policy creation succeeds and tables are
# owned by postgres (not gameday_app), which is part of why RLS constrains the
# app. The runtime API always uses DATABASE_URL (gameday_app) above.
#   Server: Chad points this at his managed-Postgres admin role, same shape.
MIGRATION_DATABASE_URL=postgresql://postgres:local_dev_only_change_me@localhost:5432/gameday

# Dedicated non-superuser connection for login identity lookup, SportsBB
# configuration, and LOC cross-delegation review. It receives only the table
# privileges required by those workflows. Production startup requires it.
PLATFORM_DATABASE_URL=postgresql://gameday_platform:local_dev_only_platform_pw@localhost:5432/gameday

# ---- Redis -----------------------------------------------------------
REDIS_PASSWORD=local_dev_only_redis
REDIS_URL=redis://:local_dev_only_redis@localhost:6379

# ---- Object storage (MinIO locally -> S3-compatible in production) ---
# Local: these are the MinIO root credentials. Server: real bucket keys.
# The application's storage code is identical in both — only the
# endpoint and keys change. MinIO requires path-style addressing.
MINIO_ROOT_USER=gameday
MINIO_ROOT_PASSWORD=local_dev_only_minio
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gameday
S3_SECRET_KEY=local_dev_only_minio
S3_BUCKET_PHOTOS=gameday-photos
S3_BUCKET_BADGES=gameday-badges
S3_BUCKET_IDENTITY=gameday-identity
S3_FORCE_PATH_STYLE=true

# ---- Surface base URLs -----------------------------------------------
# Match the hosts-file entries and the Caddy routes.
API_BASE_URL=https://api.netballamericas.test
PUBLIC_BASE_URL=https://www.netballamericas.test
TEAMS_BASE_URL=https://teams.netballamericas.test
PLATFORM_BASE_URL=https://platform.netballamericas.test
STATS_BASE_URL=https://stats.netballamericas.test
NEXT_PUBLIC_PUBLIC_SITE_URL=https://www.netballamericas.test

# ---- Auth / sessions -------------------------------------------------
# Secret used to sign the session JWT cookie. Chad sets a strong random value
# on the server; this is a local dev placeholder only.
SESSION_SECRET=local_dev_only_session_secret_change_me
# Cookie domain so the session cookie is shared across the subdomains
# (teams -> api). Server: .netballamericas.org
COOKIE_DOMAIN=.netballamericas.test

# One-time idempotent SportsBB control-plane bootstrap. Use a unique strong
# secret in production, run db:bootstrap-control, then remove the password from
# the runtime environment.
SPORTSBB_ADMIN_EMAIL=control@sportsbb.org
SPORTSBB_ADMIN_NAME=SportsBB Platform Administrator
SPORTSBB_ADMIN_PASSWORD=replace_with_strong_one_time_secret

# One-time idempotent bootstrap for the event's single authorised LOC officer.
# Use a named individual and unique strong secret in production, run
# db:bootstrap-loc, then remove LOC_ADMIN_PASSWORD from the runtime environment.
LOC_ADMIN_EMAIL=loc.officer@netballamericas.org
LOC_ADMIN_NAME=Authorised LOC Officer
LOC_ADMIN_PASSWORD=replace_with_strong_one_time_secret

# Restricted Website News and Advertising account. Set these temporarily, run
# db:bootstrap-media-comms, then remove MEDIA_COMMS_PASSWORD from the environment.
MEDIA_COMMS_EMAIL=media@netballamericas.org
MEDIA_COMMS_NAME=Media & Comms Assistant
MEDIA_COMMS_PASSWORD=replace_with_strong_one_time_secret

# Optional enhanced match capture crew. Accounts can also be created and
# assigned from LOC > Matches > GameDay staffing & access.
STATS_RECORDER_EMAIL=stats.recorder@netballamericas.org
STATS_RECORDER_NAME=Stats Recorder
STATS_RECORDER_PASSWORD=replace_with_strong_one_time_secret
STATS_HOST_EMAIL=match.host@netballamericas.org
STATS_HOST_NAME=Match Host
STATS_HOST_PASSWORD=replace_with_strong_one_time_secret
# Optional fixture UUID assigned during bootstrap.
STATS_MATCH_ID=

# Local/UAT-only shared password for the idempotent synthetic rehearsal pack.
# Supply this only while running `pnpm --filter api db:prepare-rehearsal` and
# remove it afterward. Production creation additionally requires the explicit
# ALLOW_PRODUCTION_REHEARSAL_DATA=true safety override.
REHEARSAL_PASSWORD=replace_with_strong_rehearsal_secret
# Optional verifier target. Local runs default to the API loopback to avoid
# depending on the workstation's development certificate trust store.
REHEARSAL_API_ORIGIN=http://localhost:3000

# HTTPS endpoint owned by the deployment's transactional email provider. The
# API posts {to, template, subject, variables}; production password recovery
# refuses to claim success when this delivery seam is absent.
EMAIL_WEBHOOK_URL=https://mailer.example.org/gameday/send

# Direct SMTP alternative. Leave EMAIL_WEBHOOK_URL empty when SMTP is used.
SMTP_HOST=mail.netballamericas.org
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_FROM=GameDay <loc@netballamericas.org>
# Leave SMTP_USER and SMTP_PASSWORD empty only when the server explicitly
# permits relay from the GameDay production host.
SMTP_USER=
SMTP_PASSWORD=
LOC_NOTIFICATION_EMAIL=loc@netballamericas.org

# Venue edge synchronization. Use the same strong secret in the cloud API and
# the controlled venue edge secret store; never embed it in the edge database.
EDGE_SYNC_SECRET=replace_with_strong_edge_sync_secret
EDGE_SYNC_INTERVAL_MS=5000
ANALYTICS_MIN_COMPLETED_MATCHES=1
# Public website launch gate. Omit or use "coming-soon" for the lightweight
# placeholder; set to "full" when the complete tournament site is ready.
PUBLIC_SITE_MODE=coming-soon
